{
  "manifest_version": 3,
  "name": "Tab Page Down",
  "version": "1.0.0",
  "description": "Use Tab as Page Down on webpages while preserving Tab in interactive controls.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tab-page-down.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
