{
  // Theme and Icons
  "workbench.colorTheme": "Ayu Mirage",
  "workbench.iconTheme": "ayu",
  "workbench.productIconTheme": "icons-carbon",

  // Editor - Cursor
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",

  // Editor - Font (using your installed JetBrains Mono NL Nerd Font)
  "editor.fontSize": 14,
  "editor.fontFamily": "'JetBrainsMonoNL Nerd Font', 'JetBrains Mono NL', 'JetBrains Mono', monospace",
  "editor.lineHeight": 1.6,
  "editor.fontWeight": "400",
  "editor.letterSpacing": 0.5,
  "editor.fontLigatures": true,

  // Window - Fix zoom level (was -1 causing size issues)
  "window.zoomLevel": 0,
  "window.commandCenter": true,
  "window.titleBarStyle": "custom",

  // Layout - Zed-like
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "right",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.labelFormat": "default",
  "workbench.editor.showIcons": false,

  // Editor - Clean UI
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.guides.indentation": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.bracketPairColorization.enabled": true,

  // Line numbers and gutter
  "editor.lineNumbers": "on",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.matchBrackets": "never",
  "editor.renderWhitespace": "none",

  // Breadcrumbs
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolPath": "off",

  // Tree/Explorer
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none",

  // Terminal font
  "terminal.integrated.fontFamily": "'JetBrainsMonoNL Nerd Font', monospace",
  "terminal.integrated.fontSize": 13,

  // Color customizations for dark theme
  "workbench.colorCustomizations": {
    "[Ayu Mirage]": {
      "editor.background": "#1A1A1A",
      "editorGutter.background": "#1A1A1A",
      "breadcrumb.background": "#1A1A1A",
      "breadcrumb.foreground": "#666666",
      "breadcrumb.focusForeground": "#999999",
      "breadcrumb.activeSelectionForeground": "#AAAAAA",
      "sideBar.background": "#141414",
      "sideBar.border": "#141414",
      "activityBar.background": "#141414",
      "activityBar.border": "#141414",
      "editorGroupHeader.tabsBackground": "#141414",
      "editorGroupHeader.tabsBorder": "#141414",
      "tab.activeBackground": "#141414",
      "tab.inactiveBackground": "#141414",
      "tab.border": "#141414",
      "terminal.background": "#141414",
      "panel.background": "#141414",
      "panel.border": "#141414",
      "statusBar.background": "#141414",
      "statusBar.border": "#141414",
      "focusBorder": "#00000000",
      "input.border": "#00000000",
      "input.background": "#252525",
      "quickInput.background": "#141414",
      "quickInput.foreground": "#CCCCCC",
      "quickInputList.focusBackground": "#2d2d2d",
      "quickInputTitle.background": "#141414",
      "pickerGroup.foreground": "#575757",
      "widget.border": "#333333",
      "widget.shadow": "#000000aa",
      "editorCursor.foreground": "#FFCC66",
      "editorCursor.background": "#1A1A1A"
    }
  },

  // APC Customize UI++ (custom CSS and more)
  "apc.electron": {
    "frame": false
  },
  "apc.stylesheet": {
    ".monaco-breadcrumbs": "background-color: #141414 !important; border-bottom: 1px solid #333333 !important; height: 40px !important; min-height: 40px !important; padding-left: 12px !important; display: flex !important; align-items: center !important;",
    ".breadcrumbs-control": "background-color: #141414 !important; height: 40px !important;",
    ".monaco-breadcrumb-item": "font-family: 'JetBrainsMonoNL Nerd Font', 'JetBrains Mono NL', monospace !important; font-size: 13px !important; color: #666666 !important; line-height: 40px !important; letter-spacing: 0.2px !important;",
    ".monaco-breadcrumb-item:hover, .monaco-breadcrumb-item.active": "color: #999999 !important;",
    ".monaco-breadcrumbs .codicon-chevron-right::before, .monaco-breadcrumbs .codicon-breadcrumb-separator::before": "content: '/' !important; font-family: 'JetBrainsMonoNL Nerd Font', monospace !important; font-size: 13px !important; opacity: 0.3 !important; margin: 0 4px !important;",
    ".monaco-breadcrumbs-container": "border: none !important; box-shadow: none !important;",
    ".sidebar": "font-family: 'JetBrainsMonoNL Nerd Font', monospace !important;",
    ".quick-input-widget": "font-family: 'JetBrainsMonoNL Nerd Font', monospace !important;",
    ".tab-label": "font-family: 'JetBrainsMonoNL Nerd Font', monospace !important;",
    ".cursor-layer .cursor": "width: 2px !important;",
    ".monaco-editor .margin-view-overlays .line-numbers": "padding-right: 8px !important;",
    ".monaco-scrollable-element > .scrollbar > .slider": "border-radius: 4px !important; background: rgba(255, 255, 255, 0.1) !important;",
    ".monaco-scrollable-element > .scrollbar > .slider:hover": "background: rgba(255, 255, 255, 0.2) !important;",
    ".monaco-workbench .part.statusbar": "font-family: 'JetBrainsMonoNL Nerd Font', monospace !important; font-size: 12px !important;",
    ".monaco-icon-label-container": "font-family: 'JetBrainsMonoNL Nerd Font', monospace !important;"
  },

  // Your existing preferences
  "jupyter.askForKernelRestart": false,
  "claudeCode.preferredLocation": "panel",
  "diffEditor.ignoreTrimWhitespace": false
}
