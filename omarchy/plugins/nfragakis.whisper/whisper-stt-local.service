[Unit]
Description=Private local Whisper speech-to-text server
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/whisper-stt/runtime/whisper.cpp/build-vulkan/bin/whisper-server -m %h/.config/whisper-stt/models/ggml-large-v3-turbo-q5_0.bin -t 8 -bs 1 -bo 1 -l en --vad -vm %h/.config/whisper-stt/models/ggml-silero-v6.2.0.bin -vp 500 --host 127.0.0.1 --port 8178 --public %h/.config/whisper-stt/runtime/whisper.cpp/examples/server/public
Restart=on-failure
RestartSec=1
Nice=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
