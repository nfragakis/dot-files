{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "nfragakis.clock",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1995,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "all"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.aryan-techie.todoist"
        },
        {
          "id": "omamail",
          "defaultQuery": "in:inbox category:primary"
        },
        {
          "id": "still"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "nfragakis.agents",
          "usageWindowDays": 7,
          "providers": {
            "agy": { "enabled": false },
            "grok": { "enabled": false },
            "minimax": { "enabled": false },
            "opencode": { "enabled": false },
            "zai": { "enabled": false }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "nfragakis.whisper"
    },
    {
      "id": "nfragakis.opencode-go"
    },
    {
      "id": "nfragakis.grok"
    }
  ],
  "version": 1
}
