{
  "theme": "System",
  "theme_dark": "basalt",
  "scroll_speed": 300,
  "keymap": "tmux",
  "keymap_prefix": "ctrl+s",
  "keybinds": {
    "ctrl+s>r": "reload_config",
    "ctrl+s>shift+\\": "split_right",
    "ctrl+s>minus": "split_down",
    "ctrl+s>v": "split_right",
    "ctrl+s>h": "split_down",
    "ctrl+s>x": "close_pane",
    "ctrl+s>z": "zoom",
    "alt+h": "focus_pane:left",
    "alt+j": "focus_pane:down",
    "alt+k": "focus_pane:up",
    "alt+l": "focus_pane:right",
    "ctrl+h": "plugin.nvim-nav.navigate_h",
    "ctrl+j": "plugin.nvim-nav.navigate_j",
    "ctrl+k": "plugin.nvim-nav.navigate_k",
    "ctrl+l": "plugin.nvim-nav.navigate_l",
    "ctrl+alt+shift+left": "resize_split:left",
    "ctrl+alt+shift+down": "resize_split:down",
    "ctrl+alt+shift+up": "resize_split:up",
    "ctrl+alt+shift+right": "resize_split:right",
    "ctrl+s>c": "new_tab",
    "ctrl+s>k": "close_tab",
    "ctrl+s>w": "rename_tab",
    "ctrl+s>n": "next_tab",
    "ctrl+s>p": "previous_tab",
    "alt+left": "previous_tab",
    "alt+right": "next_tab",
    "ctrl+s>s": "switch_session",
    "ctrl+s>shift+c": "new_session",
    "ctrl+s>shift+r": "rename_session",
    "ctrl+s>shift+k": "close_session",
    "alt+up": "switch_session",
    "ctrl+s>[": "open_scrollback",
    "ctrl+s>f": "files",
    "ctrl+s>g": "new_git_block",
    "ctrl+s>o": "goto_directory",
    "ctrl+s>shift+h": "switch_host",
    "ctrl+s>ctrl+s": "text:\\x13",
    "ctrl+s>tab": "plugin.hostkeys.toggle_host",
    "ctrl+s>shift+d": "plugin.hostkeys.dev",
    "ctrl+s>shift+l": "plugin.hostkeys.local",
    "ctrl+s>a": "plugin.hostkeys.agents",
    "ctrl+s>i": "inbox",
    "ctrl+s>shift+9": "plugin.hostkeys.previous_session",
    "ctrl+s>shift+0": "plugin.hostkeys.next_session",
    "ctrl+s>ctrl+k": "plugin.hostkeys.previous_session",
    "ctrl+s>ctrl+j": "plugin.hostkeys.next_session"
  }
}
